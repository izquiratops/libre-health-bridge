# Keep the existing style. Enforce whitespace without rewriting Swift constructs.
--min-version 0.63.1
--swift-version 6.0
--exclude BridgeCore/.build,BridgeCore/.swiftpm,ios
--rules consecutiveBlankLines,consecutiveSpaces,indent,linebreakAtEndOfFile,linebreaks,spaceAroundBraces,spaceAroundBrackets,spaceAroundOperators,spaceAroundParens,spaceInsideBraces,spaceInsideBrackets,spaceInsideParens,trailingSpace
--indent 4
--ifdef no-indent
--linebreaks lf
